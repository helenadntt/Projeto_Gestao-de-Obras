# =============================================================
# .env.example — Variáveis de Ambiente do Projeto Gestão de Obras
# Copie este arquivo para .env e ajuste conforme seu ambiente.
# =============================================================

# PostgreSQL
POSTGRES_DB=gestao_obras
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Backend (Spring Boot)
# Use "dev,demo" para popular dados de demonstração ou apenas "dev" para banco limpo
SPRING_PROFILES_ACTIVE=dev,demo
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (Next.js)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api
