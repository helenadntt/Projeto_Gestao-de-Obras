# =============================================================
# .gitignore — Gestão de Obras API
# Cobre: Java, Maven, Spring Boot, IDEs (IntelliJ, Eclipse, VS Code)
# =============================================================

# ─── Build & Compilação ───────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# ─── Maven ───────────────────────────────────────────────────
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
# Mantém o mvnw e mvnw.cmd para facilitar execução sem Maven local
!.mvn/wrapper/MavenWrapperDownloadFromMavenCentral.java

# ─── Spring Boot ─────────────────────────────────────────────
# Arquivos de configuração locais com credenciais reais (NÃO versionar)
application-local.yml
application-local.properties
*.env
.env
.env.*
!.env.example

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ─── IntelliJ IDEA ───────────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
out/
.idea_modules/

# ─── Eclipse ─────────────────────────────────────────────────
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
bin/

# ─── VS Code ─────────────────────────────────────────────────
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ─── NetBeans ────────────────────────────────────────────────
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ─── macOS ───────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ─── Windows ─────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── Linux ───────────────────────────────────────────────────
*~

# ─── Outros ──────────────────────────────────────────────────
*.tmp
*.bak
*.swp
*.orig
