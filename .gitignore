# =============================================================
# .gitignore — Gestão de Obras (Backend Java + Frontend Next.js)
# =============================================================

# ─── Build & Compilação Java / Maven ─────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/MavenWrapperDownloadFromMavenCentral.java

# ─── Frontend Node / Next.js ─────────────────────────────────
node_modules/
.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# ─── Ambiente & Credenciais (NÃO versionar) ──────────────────
application-local.yml
application-local.properties
.env
.env.*
!.env.example
!.env.local.example

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ─── IDEs & OS ───────────────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
.classpath
.project
.settings/
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.bak
*.swp
